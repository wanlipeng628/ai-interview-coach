# ============================================================
# 部署环境变量示例
# 使用方法：复制为项目根目录的 .env，然后填写真实值
#   cp .env.deploy.example .env
# 注意：.env 含密钥，切勿提交到 git（.gitignore 已忽略）
# ============================================================

# ---------- 数据库（容器内自建，密码请改强） ----------
POSTGRES_USER=interview
POSTGRES_PASSWORD=请替换成你的强密码
POSTGRES_DATABASE=interview_coach

# ---------- 大模型 ----------
# 注意：之前暴露过的 Key 请先吊销，重新生成一个再填这里
LLM_PROVIDER=sensenova
LLM_API_KEY=sk-请替换成新生成的Key
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
